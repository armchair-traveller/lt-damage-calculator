OPENAI_API_KEY=

# Runtime only. Configure different app ids and backend secrets in Vercel Preview
# and Production so preview traffic can never read or mutate production Jazz data.
# The app id and server URL are intentionally exposed to the browser.
PUBLIC_JAZZ_APP_ID=
PUBLIC_JAZZ_SERVER_URL=https://v2.sync.jazz.tools/
JAZZ_BACKEND_SECRET=

# Release/CLI only. Never add this secret to a Vercel runtime environment.
JAZZ_ADMIN_SECRET=

# Production Vercel runtime only. Vercel sends this value as
# `Authorization: Bearer …` to the cleanup cron.
CRON_SECRET=
